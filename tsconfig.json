{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": true,
    // mapbox-gl's shipped .d.ts references the `GeoJSON` UMD global (from @types/geojson) from
    // inside a module. Without this, skipLibCheck swallows the resulting error and GeoJSONFeature
    // silently loses `id` and `properties` — the two fields map interaction code reads.
    "allowUmdGlobalAccess": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictNullChecks": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@payload-config": [
        "./src/payload.config.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-sitemap.config.cjs",
    "next.config.js",
    "redirects.js",
    ".next-e2e/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/migrations"
  ]
}
